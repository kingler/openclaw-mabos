# Copy to `typedb.env` and adjust as needed:  cp typedb.env.example typedb.env
# Consumed by docker-compose.yml and typedb.sh.

# TypeDB server image tag. Use a pinned 3.x version for reproducibility.
TYPEDB_VERSION=3.7.0

# Container + volume names.
TYPEDB_CONTAINER=mabos-typedb
TYPEDB_VOLUME=mabos-typedb-data

# Host ports. The HTTP port is what MABOS connects to.
# Container HTTP API is always 8000; we publish it as 8729 to match the
# MABOS `TYPEDB_URL` port convention.
TYPEDB_HTTP_PORT=8729
TYPEDB_NATIVE_PORT=1729

# ── MABOS runtime wiring (export these in the shell that runs MABOS) ────────
# Point MABOS at the local server. Without this, MABOS uses its built-in
# remote default and your local container is ignored.
#   export TYPEDB_URL=http://127.0.0.1:8729
#
# Default credentials baked into the image (override in production):
#   username: admin
#   password: password
#
# To run MABOS fully file-based and skip TypeDB entirely:
#   export TYPEDB_SKIP=1
